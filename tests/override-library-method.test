// This is an LLVM-style lit test that uses FileCheck.
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: split-file %s %t
// RUN: sed -e "s|TESTDIR|%t|g" %t/compile_commands.json.in > %t/compile_commands.json
// RUN: xunused --report-functions %t/compile_commands.json 2>&1 | FileCheck %s
// CHECK-NOT: MyException::MyException{{.*}}unused
// CHECK-NOT: MyException::what{{.*}}unused

//--- override-library-method.cc
#include <iostream>
#include <exception>
#include <string>

class MyException : public std::exception {
public:
    MyException(const std::string& msg) : message(msg) {}
    const char* what() const noexcept override { return message.c_str(); }
    std::string message;
};

int main() { return 0; }

//--- compile_commands.json.in
[
  {
    "directory": "TESTDIR",
    "command": "cc -c TESTDIR/override-library-method.cc",
    "file": "TESTDIR/override-library-method.cc"
  }
]
