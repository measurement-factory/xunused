// This is an LLVM-style lit test that uses FileCheck.
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: split-file %s %t
// RUN: sed -e "s|TESTDIR|%t|g" %t/compile_commands.json.in > %t/compile_commands.json
// RUN: xunused --report-functions --special-functions %t/compile_commands.json 2>&1 | FileCheck %s
// CHECK: Box::convert1{{.*}}uses=1
// CHECK: Box::convert2{{.*}}is unused

//--- template-members-common-class.cc
class Box {
private:
public:
    int contents = 0;
    Box(int item) : contents(item) {}
    template <class T>
    T convert1() { return static_cast<T>(contents); }
    template <class T>
    T convert2() { return static_cast<T>(contents); }
};

int main() {
    auto box = Box(5);
    auto pi = box.convert1<double>();
}

//--- compile_commands.json.in
[
  {
    "directory": "TESTDIR",
    "command": "cc -c TESTDIR/template-members-common-class.cc",
    "file": "TESTDIR/template-members-common-class.cc"
  }
]
