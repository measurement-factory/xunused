// This is an LLVM-style lit test that uses FileCheck.
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: split-file %s %t
// RUN: sed -e "s|TESTDIR|%t|g" %t/compile_commands.json.in > %t/compile_commands.json
// RUN: xunused --report-functions --special-functions %t/compile_commands.json 2>&1 | FileCheck %s
// CHECK: Storage1::print{{.*}}uses=1
// CHECK-NOT: Storage1::print{{.*}}is unused
// CHECK: Storage2::print{{.*}}is unused

//--- template-class-partial-specializations.cc

template <typename T>
class Storage1 {
public:
    void print(T value) { }
};

template <typename T>
class Storage1<T*> {
public:
    void print(T* ptr) { }
};

template <typename T>
class Storage2 {
public:
    void print(T value) { }
};

template <typename T>
class Storage2<T*> {
public:
    void print(T* ptr) { }
};

int main() {
    Storage1<int*> s;
    int x = 100;
    s.print(&x);
    return 0;
}

//--- compile_commands.json.in
[
  {
    "directory": "TESTDIR",
    "command": "cc -c TESTDIR/template-class-partial-specializations.cc",
    "file": "TESTDIR/template-class-partial-specializations.cc"
  }
]
