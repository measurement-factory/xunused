// This is an LLVM-style lit test that uses FileCheck.
//
// RUN: rm -rf %t && mkdir -p %t
// RUN: split-file %s %t
// RUN: sed -e "s|TESTDIR|%t|g" %t/compile_commands.json.in > %t/compile_commands.json
// RUN: xunused --report-functions --special-functions %t/compile_commands.json 2>&1 | FileCheck %s
// CHECK: convert1{{.*}}uses=1
// CHECK: convert2{{.*}}is unused

//--- template-functions.cc
template <class T>
T convert1(int t) { return static_cast<int>(t); }

template <class T>
T convert2(int t) { return static_cast<int>(t); }

int main() {
    auto v1 = convert1<double>(5);
}

//--- compile_commands.json.in
[
  {
    "directory": "TESTDIR",
    "command": "cc -c TESTDIR/template-functions.cc",
    "file": "TESTDIR/template-functions.cc"
  }
]
